# ============================================================
# Konfigurasi Backup — salin ke .env dan sesuaikan nilainya
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_finance

# --- Path ---
# Server Linux: simpan di luar document root.
# Path relatif hanya untuk development lokal.
BACKUP_DIR=/var/lib/finance-backup/dumps
LOG_DIR=/var/lib/finance-backup/logs

# --- Retention ---
# Backup tidak pernah langsung dihapus oleh backup_full.sh. Kebijakan A5.15
# memindahkan kandidat tervalidasi ke quarantine setelah 35 hari dan tetap
# mempertahankan minimal 14 backup terbaru.

# --- Mode ---
# full  = dump semua tabel (default, untuk backup reguler)
# partial = hanya tabel kunci (lebih cepat, untuk health check)
BACKUP_MODE=full

# Backup runner hanya menyimpan dump dan log di host ini.
# Konfigurasikan backup off-site terenkripsi secara terpisah.

# Tabel yang DIKECUALIKAN dari dump (pisahkan koma, tanpa spasi)
# Contoh tabel log besar yang tidak kritis untuk restore cepat
EXCLUDE_TABLES=sys_audit_log,att_presence
