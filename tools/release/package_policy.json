{
  "schema": "finance.release-package-policy",
  "schema_version": 2,
  "include_roots": [
    "application/",
    "assets/",
    "docs/",
    "scripts/",
    "sql/",
    "system/",
    "tools/",
    "wa-engine/"
  ],
  "include_files": [
    "MULAI-DI-SINI.html",
    "MULAI-DI-SINI.txt",
    "config/.htaccess",
    "config/customer.example.json",
    ".htaccess",
    "README.md",
    "app-manifest.json",
    "composer.lock",
    "composer.json",
    "index.php",
    "license.txt",
    "readme.rst"
  ],
  "allow_exact": [
    "application/cache/index.html",
    "application/logs/index.html"
  ],
  "deny_exact": [
    "config/customer.json",
    ".user.ini",
    "application/controllers/Audit.php",
    "application/libraries/AuditRoadmapReader.php",
    "docs/_NOTE.md"
  ],
  "deny_prefixes": [
    ".agents/",
    ".codex/",
    ".git/",
    ".vscode/",
    "application/cache/",
    "application/logs/",
    "assets/uploads/",
    "backup/",
    "application/views/audit/",
    "docs/2026-",
    "docs/_NOTE",
    "docs/_old/",
    "output/",
    "sql/_old/",
    "tmp/",
    "tools/telegram/codex_bridge/",
    "uploads/",
    "vendor/"
  ],
  "deny_segments": [
    "/.runtime/",
    "/.venv/",
    "/__pycache__/",
    "/node_modules/"
  ],
  "deny_basenames": [
    ".env"
  ],
  "deny_suffixes": [
    ".log",
    ".pid",
    ".sql.gz",
    ".swp",
    "_bak.php",
    "~"
  ],
  "secret_scan_extensions": [
    "php",
    "js",
    "py",
    "sh",
    "json",
    "ini",
    "yaml",
    "yml",
    "xml",
    "sql"
  ],
