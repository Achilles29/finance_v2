# Template development tanpa secret. Untuk production, inject credential dari
# secret manager/process manager di luar web root; jangan simpan nilainya di sini.

WA_PORT=3070

# Nama process-only untuk dokumentasi. Loader sengaja mengabaikan nilai key ini;
# inject nilai nyata melalui service/process manager di luar web root.
FINANCE_WA_ENGINE_API_TOKEN=

FINANCE_COMMAND_URL=https://finance.example.invalid/wa/api/group-command
FINANCE_WA_ENGINE_COMMAND_TOKEN=

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_finance
